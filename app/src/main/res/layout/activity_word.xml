<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="48dp"
    tools:context=".WordActivity">

    <FrameLayout
        android:id="@+id/layout_for_btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/layout_word"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_for_btn_back"
        app:layout_constraintVertical_bias="0.4" />

    <io.github.farzadski.essential504.Components.MyCustomSquircleCardView
        android:id="@+id/btn_done"
        android:layout_width="128dp"
        android:layout_height="96dp"
        android:layout_marginBottom="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:squircleBackgroundColor="#E0F7FA"
        app:squircleBottomLeftRadius="48dp"
        app:squircleBottomRightRadius="48dp"
        app:squircleControlFactor="0.95"
        app:squircleStrokeColor="#000000"
        app:squircleStrokeWidth="4dp"
        app:squircleTopLeftRadius="48dp"
        app:squircleTopRightRadius="48dp">

        <io.github.farzadski.essential504.Components.MyCustomTextViewExtraBoldFont
            android:id="@+id/txt_btn_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="@string/done"
            android:textSize="16sp" />

    </io.github.farzadski.essential504.Components.MyCustomSquircleCardView>

</androidx.constraintlayout.widget.ConstraintLayout>